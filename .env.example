# OPUS67 Environment Variables
# 
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to version control.

# ============================================================
# Database (Supabase)
# ============================================================
# Required for production persistence.
# Get these from your Supabase project settings.
# 
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key
# VITE_SUPABASE_SERVICE_KEY=your-service-role-key (SECRET - server-side only)

# ============================================================
# AI Providers
# ============================================================
# At least one provider is required for AI functionality.
# Get API keys from provider dashboards.
# 
# OpenAI: https://platform.openai.com/api-keys
# VITE_OPENAI_API_KEY=sk-...
# 
# Anthropic: https://console.anthropic.com/settings/keys
# VITE_ANTHROPIC_API_KEY=sk-ant-...

# ============================================================
# Authentication (Phase III)
# ============================================================
# Required for user authentication.
# 
# AUTH_SECRET=your-secret-key-min-32-chars
# 
# Google OAuth: https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# 
# GitHub OAuth: https://github.com/settings/developers
# GITHUB_CLIENT_ID=your-github-client-id
# GITHUB_CLIENT_SECRET=your-github-client-secret

# ============================================================
# Payment Provider (Phase III)
# ============================================================
# Required for billing functionality.
# Use test keys for development.
# 
# PAYMENT_MODE=test
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PUBLIC_KEY=pk_test_...

# ============================================================
# Logging
# ============================================================
LOG_LEVEL=info
