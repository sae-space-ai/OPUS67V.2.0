# OPUS67 Environment Variables
# 
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to version control.

# ============================================================
# AI Providers (Optional)
# ============================================================
# Required for AI functionality. Leave empty to use mock mode.
# OPENAI_API_KEY=your_openai_api_key
# ANTHROPIC_API_KEY=your_anthropic_api_key

# ============================================================
# Database (Optional)
# ============================================================
# Required for production. Uses localStorage in development.
# DATABASE_URL=postgresql://user:password@localhost:5432/opus67

# ============================================================
# Authentication (Required for Identity & Access)
# ============================================================
# AUTH_SECRET must be at least 32 characters, random string
# Generate with: openssl rand -base64 32
# AUTH_SECRET=your-secret-key-min-32-chars-long

# Google OAuth (Optional)
# Create at: https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret

# GitHub OAuth (Optional)
# Create at: https://github.com/settings/developers
# GITHUB_CLIENT_ID=your-github-client-id
# GITHUB_CLIENT_SECRET=your-github-client-secret

# ============================================================
# Payment Provider (Optional)
# ============================================================
# Required for billing. Use test keys for development.
# PAYMENT_MODE=test  # or 'live' for production
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PUBLIC_KEY=pk_test_...

# ============================================================
# Logging
# ============================================================
LOG_LEVEL=info

# ============================================================
# Application
# ============================================================
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# NEXT_PUBLIC_APP_NAME=OPUS67
