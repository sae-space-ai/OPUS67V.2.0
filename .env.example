# OPUS67 — Environment Variables

# ============================================================
# REQUIRED (for production)
# ============================================================
# These are required when deploying to production with external services.

# DATABASE_URL=postgresql://user:password@host:5432/opus67
# (Compatible with Neon, Supabase, or any PostgreSQL provider)

# ============================================================
# OPTIONAL — AI PROVIDERS
# ============================================================
# Configure at least one provider to enable AI functionality.
# Without providers, the application runs in configuration-required mode.

# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# ============================================================
# OPTIONAL — OBSERVABILITY
# ============================================================

# LOG_LEVEL=info
# (Options: debug, info, warn, error)

# ============================================================
# NOTES
# ============================================================
# - Never commit actual secret values to version control.
# - In Vercel, configure these as Environment Variables in the dashboard.
# - Provider API keys are server-side only — never exposed to the client.
# - The application can start without providers (degraded mode).
# - Database is required for persistence features (future).
